# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmusic?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="openmusic"

# Redis (Real-Time Pub/Sub & Presence Cache)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=4000
HOST="0.0.0.0"
# HS256 key, at least 32 characters. REQUIRED in production (generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# In development an ephemeral key is generated when unset (sessions reset on restart).
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=604800
# Browser origins allowed to call the API and open the Socket.io connection (comma-separated).
CORS_ORIGIN="http://localhost:3000,exp://localhost:8081"
# Session cookie flags. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Set COOKIE_DOMAIN (e.g. ".openmusic.social") when web and api live on sibling subdomains.
COOKIE_SECURE=false
# COOKIE_DOMAIN=".openmusic.social"
# Set to true behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=false
# Max login/register/password attempts per IP per minute.
AUTH_RATE_LIMIT_MAX=10

# Web app (Next.js reads this root .env via next.config.mjs)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Spotify Web API OAuth2 (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_REDIRECT_URI="http://localhost:4000/api/auth/spotify/callback"

# Last.fm API (https://www.last.fm/api/account/create)
LASTFM_API_KEY="your_lastfm_api_key"
LASTFM_SHARED_SECRET="your_lastfm_shared_secret"
LASTFM_CALLBACK_URL="http://localhost:4000/api/auth/lastfm/callback"
