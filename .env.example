# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmusic?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="openmusic"

# Redis (Real-Time Pub/Sub & Presence Cache)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=4000
HOST="0.0.0.0"
# HS256 key, at least 32 characters. REQUIRED in production (generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# In development an ephemeral key is generated when unset (sessions reset on restart).
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=604800
# Browser origins allowed to call the API and open the Socket.io connection (comma-separated).
# Local dev uses the loopback IP 127.0.0.1 everywhere (never `localhost`): Spotify only accepts
# loopback IP redirect URIs, and with the default callbacks below on :4000 the OAuth state cookie
# (set through the web app's /api proxy on 127.0.0.1) must reach the API on the same host.
# Open the web app at http://127.0.0.1:3000.
CORS_ORIGIN="http://127.0.0.1:3000,exp://127.0.0.1:8081"
# Session cookie flags. COOKIE_SECURE defaults to true when NODE_ENV=production.
# COOKIE_DOMAIN is not needed with the web app's /api proxy (cookies belong to the web origin).
COOKIE_SECURE=false
# COOKIE_DOMAIN=".openmusic.social"
# Set to true behind a reverse proxy (Render) so rate limiting sees real client IPs.
TRUST_PROXY=false
# Shared secret between the web app's /api proxy and the API (min 32 chars). With it the API
# rate-limits proxied requests on the browser's IP instead of the web server's. Optional locally;
# render.yaml generates it.
# PROXY_SECRET=""
# API log level (fatal|error|warn|info|debug|trace|silent). Default: info in development, warn otherwise.
# LOG_LEVEL=info
# Public URL the browser opens Socket.io on (GET /api/auth/socket-token tells the web app).
# Default: RENDER_EXTERNAL_URL on Render, else http://127.0.0.1:<PORT>.
# PUBLIC_API_URL="http://127.0.0.1:4000"
# First-deploy data (docs/07_DEPLOY.md): import the curated real albums once on API start.
# SEED_ON_START=false
# With SEED_ON_START=true, also create the demo community once, every account with this
# password (min 12 chars). Leave unset for no demo accounts.
# DEMO_PASSWORD=
# Max login/register/password attempts per IP per minute.
AUTH_RATE_LIMIT_MAX=10

# Web app (Next.js reads this root .env via next.config.mjs). The browser only talks to the web
# origin: /api/* is proxied server-side to API_ORIGIN (ADR-014, docs/06_API_AND_AUTH.md §1).
# API_ORIGIN is server-only and read at runtime; NEXT_PUBLIC_API_URL is its fallback (older .env).
API_ORIGIN="http://127.0.0.1:4000"
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
# Public URL of the web app: Spotify/Last.fm OAuth callbacks redirect the browser back here
# (/settings?oauth=<provider>&status=success|error&code=<ApiErrorCode>).
WEB_APP_URL="http://127.0.0.1:3000"

# External music catalogs (Deezer, iTunes, MusicBrainz, Cover Art Archive): no API keys needed.
# false = search and release pages use only the local database (no outbound calls).
CATALOG_EXTERNAL_ENABLED=true
# Contact sent in the MusicBrainz User-Agent ("OpenMusic/<version> ( <contact> )"), required by
# their API policy. Use a URL or an email you read.
MUSICBRAINZ_CONTACT="https://github.com/francoSpagnati/openmusic"
# iTunes storefront (fallback search/artwork).
ITUNES_COUNTRY="IT"
# `npm run db:seed` upgrades the seeded albums with real covers/tracklists when Deezer is reachable.
# Set to false to keep the offline seed exactly as it is (CI does).
CATALOG_SEED_IMPORT=true

# Automatic now-playing sync (ADR-013): the API reads linked Spotify / Last.fm accounts in the
# background. Defaults to true (false when NODE_ENV=test; CI and Playwright set it to false).
NOW_PLAYING_POLLER_ENABLED=true
# Fast interval (user or a follower online, or something played in the last 10 minutes).
NOW_PLAYING_ACTIVE_INTERVAL_SECONDS=25
# Slow interval for idle users.
NOW_PLAYING_IDLE_INTERVAL_SECONDS=180
# Users not seen in the app for this many days are not polled (their accounts become PAUSED).
NOW_PLAYING_INACTIVE_AFTER_DAYS=14
# Users read in parallel by one API instance.
NOW_PLAYING_POLL_CONCURRENCY=4

# Spotify Web API OAuth2 (https://developer.spotify.com/dashboard). Register exactly this
# redirect URI in the Spotify app: Spotify rejects `localhost`, only loopback IPs (127.0.0.1).
# When unset it defaults to <WEB_APP_URL>/api/auth/spotify/callback (through the web proxy):
# that is the URI to register in production (docs/07_DEPLOY.md). Same for LASTFM_CALLBACK_URL.
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:4000/api/auth/spotify/callback"

# Last.fm API (https://www.last.fm/api/account/create). The API key alone is enough for the
# automatic "now playing" reading (user.getRecentTracks); the secret is for linking accounts.
LASTFM_API_KEY="your_lastfm_api_key"
LASTFM_SHARED_SECRET="your_lastfm_shared_secret"
LASTFM_CALLBACK_URL="http://127.0.0.1:4000/api/auth/lastfm/callback"
