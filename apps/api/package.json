{
  "name": "@openmusic/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:smoke": "tsx scripts/catalog-smoke.ts",
    "catalog:audit": "tsx scripts/catalog-audit.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@openmusic/db": "*",
    "@openmusic/shared": "*",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "socket.io-client": "~4.8.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
