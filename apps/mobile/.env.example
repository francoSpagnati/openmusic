# Copy to apps/mobile/.env. Inlined by Metro at build time (never put secrets here).
# iOS simulator on the same machine: http://127.0.0.1:4000 (same loopback host as the web app)
# Android emulator: http://10.0.2.2:4000 — physical device / Expo Go: http://<your LAN IP>:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
