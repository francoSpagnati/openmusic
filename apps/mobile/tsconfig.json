{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "declaration": false,
    "types": ["jest"]
  },
  "include": ["app/**/*", "src/**/*", "expo-env.d.ts", "jest.setup.ts"],
  "exclude": ["node_modules", "dist-smoke"]
}
