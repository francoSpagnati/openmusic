{
  "expo": {
    "name": "OpenMusic",
    "slug": "openmusic",
    "scheme": "openmusic",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#14120F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "social.openmusic.app"
    },
    "android": {
      "package": "social.openmusic.app",
      "adaptiveIcon": {
        "backgroundColor": "#14120F"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    }
  }
}
