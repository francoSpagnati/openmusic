# OpenMusic self-hosted: copy to `.env` in this folder (deploy/selfhost/.env) and fill it in.
# Guide: docs/08_SELF_HOSTING.md. Never commit `.env` (it is git- and docker-ignored).
#
# Generate the three secrets (letters and digits only, safe inside the database URL):
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env
#   sed -i "s/^PROXY_SECRET=.*/PROXY_SECRET=$(openssl rand -hex 32)/" .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env

# --- Required ---------------------------------------------------------------------------------

# Session signing key (>= 32 chars). Changing it signs everybody out.
JWT_SECRET=
# Shared by the web proxy and the API (>= 32 chars): rate limiting by the browser's IP.
PROXY_SECRET=
# Postgres password. Hex only (it goes into a URL). Set it BEFORE the first start: the database
# is created with it, and changing it later needs ALTER USER (docs §12).
POSTGRES_PASSWORD=

# The ONE address people open (web, API and socket share it). No trailing slash.
#   Tailscale Serve/Funnel (recommended): https://<machine>.<tailnet>.ts.net
#   LAN only (plain http, see COOKIE_SECURE):  http://192.168.1.50:8380
PUBLIC_URL=https://openmusic.example-tailnet.ts.net
# true with https (Tailscale). false ONLY for the plain-http LAN mode: session cookies then travel
# unencrypted on your network (docs §6.3).
COOKIE_SECURE=true

# --- Network ----------------------------------------------------------------------------------

# Host port of the single entrypoint (Caddy). CasaOS itself uses 80.
OPENMUSIC_PORT=8380
# 0.0.0.0 = LAN can open http://<lan-ip>:8380; 127.0.0.1 = only this machine (and Tailscale
# Serve running on it).
OPENMUSIC_BIND=0.0.0.0
# Who may set X-Forwarded-For in front of Caddy (Docker networks: tailscaled, the sidecar).
# TRUSTED_PROXIES=172.16.0.0/12 127.0.0.1/8

# --- Images -----------------------------------------------------------------------------------

# Prebuilt images from GitHub Container Registry (CI: .github/workflows/images.yml), or local
# ones after `docker compose build`. Pin a commit with OPENMUSIC_TAG=sha-<7 chars>.
OPENMUSIC_IMAGE_PREFIX=ghcr.io/francospagnati/openmusic
OPENMUSIC_TAG=latest

# --- First start ------------------------------------------------------------------------------

# Import the curated real albums once (Deezer/iTunes, needs internet), tracked in the database.
SEED_ON_START=true
# Optional: a long private password (>= 12 chars) creates the demo community once
# (francospagnati@openmusic.test, admin@openmusic.test with role ADMIN, ...). Empty = none.
DEMO_PASSWORD=

# --- Optional linked accounts (empty = the app works without them) -----------------------------

# Spotify redirect URI to register: <PUBLIC_URL>/api/auth/spotify/callback (https only).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Last.fm callback URL to register: <PUBLIC_URL>/api/auth/lastfm/callback
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# --- Tuning (defaults are fine) ---------------------------------------------------------------

TZ=Europe/Rome
# LOG_LEVEL=info
# Login/register attempts per client IP per minute.
# AUTH_RATE_LIMIT_MAX=10
# CATALOG_EXTERNAL_ENABLED=true
# NOW_PLAYING_POLLER_ENABLED=true
# Seconds between Spotify/Last.fm reads while someone is active: lower = faster track changes
# and seeks on profiles, more provider requests (min 10, max 300).
# NOW_PLAYING_ACTIVE_INTERVAL_SECONDS=25
# V8 heap caps (MB) inside the 512 MB container limits.
# API_MAX_OLD_SPACE_MB=320
# WEB_MAX_OLD_SPACE_MB=320

# --- Backups (`--profile backup`) -------------------------------------------------------------

# Host folder for the dumps (relative to this folder), daily time (container TZ) and retention.
BACKUP_DIR=./backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

# --- Tailscale sidecar (`--profile tailscale`; not needed with Tailscale on the host) -----------

# Auth key from https://login.tailscale.com/admin/settings/keys (only needed for the first login;
# the state is kept in the tailscale_state volume).
TS_AUTHKEY=
# Machine name: the app becomes https://<TS_HOSTNAME>.<tailnet>.ts.net (set PUBLIC_URL to it).
TS_HOSTNAME=openmusic
# true = Tailscale Funnel (public on the internet), false = Serve (tailnet only).
TS_FUNNEL=false
